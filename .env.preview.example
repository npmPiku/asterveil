# Copy this file to .env.preview and set exactly one wallet secret.
# Fund the account with Preview DUST before running integration tests.
MIDNIGHT_PREVIEW_MNEMONIC=replace-with-24-word-mnemonic
# MIDNIGHT_PREVIEW_SEED=replace-with-a-64-char-hex-seed

# Optional proof-server override.
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# Required only for the CLI deployment helper. Keep these values private.
# ASTER_VEIL_MEMBER_SECRET_HEX=64-hex-characters
# ASTER_VEIL_ADMIN_SECRET_HEX=64-hex-characters
# ASTER_VEIL_GATE_NAME=Night Archive
# ASTER_VEIL_MINIMUM_CLEARANCE=2
# ASTER_VEIL_MAX_ENTRIES=250
