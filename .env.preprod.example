# Copy this file to .env.preprod and set exactly one wallet secret.
# Fund the account with Preprod DUST before running integration tests.
MIDNIGHT_PREPROD_MNEMONIC=replace-with-24-word-mnemonic
# MIDNIGHT_PREPROD_SEED=replace-with-a-64-char-hex-seed

# Optional proof-server override. The browser deployer uses the connected wallet.
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# Required only for the CLI deployment helper. Keep these values private.
# ASTER_VEIL_MEMBER_SECRET_HEX=64-hex-characters
# ASTER_VEIL_ADMIN_SECRET_HEX=64-hex-characters
# ASTER_VEIL_GATE_NAME=Night Archive
# ASTER_VEIL_MINIMUM_CLEARANCE=2
# ASTER_VEIL_MAX_ENTRIES=250
