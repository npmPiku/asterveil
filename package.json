{
  "name": "asterveil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "node scripts/compile.js",
    "copy:managed": "node scripts/copy-managed.js",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:unit": "cross-env NODE_OPTIONS='--experimental-vm-modules' vitest run src/test/asterveil.unit.test.ts",
    "test:local": "cross-env MIDNIGHT_NETWORK=local yarn test",
    "test:preview": "cross-env MIDNIGHT_NETWORK=preview yarn test",
    "test:preprod": "cross-env MIDNIGHT_NETWORK=preprod yarn test",
    "deploy:preview": "cross-env MIDNIGHT_NETWORK=preview vite-node scripts/deploy.ts",
    "deploy:preprod": "cross-env MIDNIGHT_NETWORK=preprod vite-node scripts/deploy.ts",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "proof:up": "docker compose up -d --wait proof-server",
    "proof:down": "docker compose stop proof-server",
    "wait:dust": "vite-node scripts/wait-for-dust.ts",
    "validate": "yarn compile && yarn env:up && yarn wait:dust && yarn test:local; yarn env:down"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "cross-env": "^10.1.0",
    "typescript": "^5.7.0",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.0"
  },
  "packageManager": "yarn@1.22.22"
}
